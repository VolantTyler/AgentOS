# Copy to .env and fill in (never commit .env)
# Cursor API key for @cursor/sdk — see https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=

# Optional Slack Incoming Webhook for /ai-news digests → #news
# Also set as GitHub Actions secret SLACK_AI_NEWS_WEBHOOK_URL for scheduled posts
# See docs/integrations/slack-ai-news.md
SLACK_AI_NEWS_WEBHOOK_URL=

# Optional lead tracker Google Sheets config
LEAD_TRACKER_SPREADSHEET_ID=
LEAD_TRACKER_SHEET_RANGE=Recent Contacts!A:K

# Optional job-fit tracker Google Sheets config (local gws append)
JOB_FIT_TRACKER_SPREADSHEET_ID=
# Quote the whole value when the tab name contains spaces (match your tab exactly)
JOB_FIT_TRACKER_SHEET_RANGE='Job Fit Agent Reviews!A:R'
# GitHub Actions fallback for cloud /job-fit: see docs/integrations/scheduled-job-fit-sheet-sync.md
# Repo secrets: GWS_CREDENTIALS, JOB_FIT_TRACKER_SPREADSHEET_ID
# Optional repo variable: JOB_FIT_TRACKER_SHEET_RANGE

# Optional gws auth override — only set if credentials.json exists (from `gws auth export --unmasked`)
# GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=/absolute/path/to/credentials.json

# Optional TypeSafe key for a live Jev job-fit score preview.
# Dry-run and self-check do not need this. See docs/integrations/typesafe-jev-job-fit.md
# TYPESAFE_API_KEY=

# Opt-in metered LLM benchmark. Off unless set to 1. Does not change /job-fit.
# The call needs GEMINI_API_KEY and sends career docs to Gemini. See the Jev integration note.
# JOB_FIT_LLM_BENCHMARK=
# GEMINI_API_KEY=
